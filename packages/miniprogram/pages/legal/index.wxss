.legal-page {
  padding: 40rpx 32rpx 80rpx;
  min-height: 100vh;
  background: #0a0a1a;
}

.legal-h1 {
  font-size: 40rpx;
  font-weight: 700;
  color: #C8FF50;
  margin-bottom: 12rpx;
}

.legal-meta {
  font-size: 22rpx;
  color: #8888aa;
  margin-bottom: 24rpx;
}

.legal-body {
  font-size: 26rpx;
  color: #B8B8C8;
  line-height: 1.7;
  white-space: pre-wrap;
}
