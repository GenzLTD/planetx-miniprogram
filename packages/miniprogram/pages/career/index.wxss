.page {
  min-height: 100vh;
  background: #0a0a1a;
  color: #f4f4f8;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}
.modes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #16162a;
  color: #b8b8c8;
  font-size: 28rpx;
}
.mode.on {
  color: #0d0d1a;
  background: #c8ff50;
  font-weight: 700;
}
.editor {
  width: 100%;
  height: 280rpx;
  background: #16162a;
  color: #f4f4f8;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}
.go {
  margin-top: 20rpx;
  background: #c8ff50;
  color: #0d0d1a;
  font-weight: 700;
}
.error, .result {
  margin-top: 20rpx;
  font-size: 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.error { color: #ffb020; }
.result {
  background: #16162a;
  border-radius: 16rpx;
  padding: 20rpx;
}
.section {
  margin: 36rpx 0 12rpx;
  color: #c8ff50;
  font-size: 28rpx;
  font-weight: 700;
}
.job {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.title { display: block; font-size: 28rpx; }
.meta { display: block; margin-top: 6rpx; color: #b8b8c8; font-size: 22rpx; }
