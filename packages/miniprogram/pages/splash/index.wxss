.splash-container {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) 48rpx 48rpx;
  box-sizing: border-box;
}

.splash-logo {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

/* Loading state */
.loading-area {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(200, 255, 80, 0.2);
  border-top-color: #C8FF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #B8B8C8;
  font-size: 26rpx;
}

/* Failed state */
.login-failed {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  padding: 40rpx 32rpx;
  background: rgba(255, 60, 60, 0.08);
  border: 1rpx solid rgba(255, 60, 60, 0.2);
  border-radius: 16rpx;
}

.failed-icon {
  font-size: 48rpx;
}

.failed-text {
  color: #cc6666;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-primary {
  background: #C8FF50;
  color: #0a0a1a;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 64rpx;
  border-radius: 44rpx;
  text-align: center;
}

.btn-skip {
  color: #8888aa;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  text-align: center;
  text-decoration: underline;
}

.privacy-gate {
  margin-top: 48rpx;
  width: 100%;
  padding: 32rpx;
  background: rgba(13, 13, 26, 0.9);
  border: 1rpx solid rgba(200, 255, 80, 0.2);
  border-radius: 16rpx;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #C8FF50;
  margin-bottom: 8rpx;
}

.privacy-meta {
  font-size: 22rpx;
  color: #8888aa;
  display: block;
  margin-bottom: 16rpx;
}

.privacy-body {
  max-height: 280rpx;
  margin-bottom: 20rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: #B8B8C8;
  line-height: 1.6;
  white-space: pre-wrap;
}

.privacy-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  padding: 12rpx 8rpx;
  margin: 8rpx 0;
}

.privacy-check-hover {
  background: rgba(200, 255, 80, 0.08);
  border-radius: 12rpx;
}

.privacy-box {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  border: 2rpx solid #C8FF50;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0a0a1a;
  font-size: 26rpx;
  font-weight: 700;
}

.privacy-box.on {
  background: #C8FF50;
}

.privacy-check-label {
  flex: 1;
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.4;
}

.btn-primary-hover {
  opacity: 0.85;
}

.privacy-link {
  font-size: 22rpx;
  color: #C8FF50;
  text-decoration: underline;
  margin: 8rpx 0 20rpx;
}
