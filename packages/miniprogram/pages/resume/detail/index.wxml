<scroll-view class="resume-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="resume-header">
    <text class="resume-title">简历详情</text>
    <text class="resume-subtitle" wx:if="{{resumeId}}">ID · {{resumeId}}</text>
  </view>

  <!-- 加载态：skeleton 骨架条 -->
  <view class="resume-skeleton" wx:if="{{loading}}">
    <view class="resume-skel-card" wx:for="{{[1, 2]}}" wx:key="*this">
      <view class="resume-skel-line w60"></view>
      <view class="resume-skel-line w40"></view>
      <view class="resume-skel-line w80"></view>
      <view class="resume-skel-line w80"></view>
    </view>
  </view>

  <view class="resume-error" wx:if="{{error && !loading}}">
    <text class="resume-error-text">{{error}}</text>
    <view class="resume-retry" bindtap="loadDetail" wx:if="{{resumeId}}">
      <text>重试</text>
    </view>
    <view class="resume-cta" bindtap="goBack" wx:if="{{!resumeId}}">
      <text>返回 →</text>
    </view>
  </view>

  <view class="resume-degrade" wx:if="{{notReady && !loading}}">
    <text class="resume-degrade-badge">✦ 接口未开放</text>
    <text class="resume-degrade-title">详情接口暂不可用</text>
    <text class="resume-degrade-hint">当前后端版本尚未实现 GET /v1/resume/:resume_id（501 not_implemented）。不是加载失败，列表与解析仍可用。</text>
    <view class="resume-cta" bindtap="goBack">
      <text>返回 →</text>
    </view>
  </view>

  <!-- 正文：只读 / 编辑 -->
  <view class="resume-list" wx:if="{{!loading && !error && !notReady && detail}}">
    <view class="resume-card" wx:if="{{!editing}}">
      <view class="resume-card-row">
        <text class="resume-card-title">{{detail.title || '未命名简历'}}</text>
        <view class="edit-link" bindtap="startEdit">
          <text>编辑正文</text>
        </view>
      </view>
      <text class="resume-card-meta" wx:if="{{detail.filename}}">{{detail.filename}}</text>
      <text class="resume-card-meta" wx:if="{{visibilityText}}">可见性 · {{visibilityText}}</text>
      <text class="resume-card-meta" wx:if="{{detail.status}}">状态 · {{detail.status}}</text>
      <text class="resume-card-body" wx:if="{{detail.extracted.summary}}">{{detail.extracted.summary}}</text>
      <text class="resume-card-body muted" wx:if="{{detail.markdown}}">{{detail.markdown}}</text>
    </view>

    <view class="resume-card" wx:else>
      <text class="resume-card-title">编辑正文</text>
      <text class="edit-field-label">标题</text>
      <input
        class="edit-input"
        value="{{editTitle}}"
        maxlength="200"
        placeholder="简历标题"
        bindinput="onEditTitle"
        disabled="{{editSaving}}"
      />
      <text class="edit-field-label">摘要</text>
      <textarea
        class="edit-textarea short"
        value="{{editSummary}}"
        maxlength="2000"
        placeholder="一句话摘要（写入 extracted.summary）"
        bindinput="onEditSummary"
        disabled="{{editSaving}}"
        auto-height
      />
      <text class="edit-field-label">正文 Markdown</text>
      <textarea
        class="edit-textarea"
        value="{{editMarkdown}}"
        maxlength="50000"
        placeholder="简历原文 / 转换后的 markdown"
        bindinput="onEditMarkdown"
        disabled="{{editSaving}}"
      />
      <text class="edit-hint">只提交有改动的字段；摘要改动会整份替换 extracted（其余字段保留）。可见性请用下方「谁可看」。</text>
      <text class="perm-error" wx:if="{{editError}}">{{editError}}</text>
      <view class="edit-actions">
        <view class="edit-btn ghost {{editSaving ? 'disabled' : ''}}" bindtap="cancelEdit">
          <text>取消</text>
        </view>
        <view class="edit-btn primary {{editSaving ? 'disabled' : ''}}" bindtap="saveEdit">
          <text>{{editSaving ? '保存中…' : '保存'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 谁可看：授权面唯一写入口（metadata.permission），与 detail 读同一处 -->
  <view class="resume-list perm-list" wx:if="{{!loading && !error && !notReady && detail && !permBlocked && !editing}}">
    <view class="resume-card">
      <view class="resume-card-row">
        <text class="resume-card-title">谁可看</text>
        <text class="perm-count" wx:if="{{perm}}">{{grantCount}} 个授权对象</text>
      </view>

      <view class="perm-options">
        <view
          wx:for="{{visibilityOptions}}"
          wx:key="value"
          class="perm-option {{currentVisibility === item.value ? 'on' : ''}}"
          data-value="{{item.value}}"
          bindtap="onVisibilityTap"
        >
          <text class="perm-option-label">{{item.label}}</text>
          <text class="perm-option-hint">{{item.hint}}</text>
        </view>
      </view>

      <text class="perm-note" wx:if="{{permLoading}}">授权信息加载中…</text>
      <text class="perm-note" wx:elif="{{permSaving}}">保存中…</text>
      <text class="perm-note" wx:elif="{{permUpdatedAt}}">最近更新 · {{permUpdatedAt}}</text>
      <text class="perm-error" wx:if="{{permError}}">{{permError}}</text>
    </view>
  </view>

  <view class="resume-bottom-safe"></view>
</scroll-view>
