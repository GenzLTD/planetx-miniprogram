/* 简历页族共用：PlanetX 暗黑壳（对齐 app.wxss 主题），空态/降级不依赖 vant */
page {
  background: #0a0a1a;
  color: #e0e0ff;
}

.resume-page {
  height: 100vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.resume-header {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.resume-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.resume-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #b8b8c8;
}

/* ============ 加载骨架（shimmer） ============ */
.resume-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 16rpx;
}

.resume-skel-card {
  background: #0d0d1a;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.resume-skel-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #1a1a2e 25%, #232340 50%, #1a1a2e 75%);
  background-size: 400% 100%;
  animation: resumeShimmer 1.4s ease infinite;
}

.resume-skel-line.w40 { width: 40%; }
.resume-skel-line.w60 { width: 60%; }
.resume-skel-line.w80 { width: 80%; }

@keyframes resumeShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* ============ 错误 / 降级 / 空态 ============ */
.resume-error,
.resume-degrade,
.resume-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  text-align: center;
}

.resume-error-text {
  font-size: 28rpx;
  color: #f87171;
  margin-bottom: 24rpx;
}

.resume-retry {
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  background: rgba(200, 255, 80, 0.12);
  border: 1rpx solid rgba(200, 255, 80, 0.35);
  color: #c8ff50;
  font-size: 28rpx;
}

.resume-degrade-badge {
  font-size: 22rpx;
  color: #6b3fa0;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.resume-degrade-title {
  font-size: 30rpx;
  color: #e0e0ff;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.resume-degrade-hint {
  font-size: 24rpx;
  color: #6b6b80;
  line-height: 1.6;
  max-width: 520rpx;
}

/* 降级态导流 CTA（如：先去解析简历 / 返回） */
.resume-cta {
  margin-top: 36rpx;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  background: rgba(107, 63, 160, 0.18);
  border: 1rpx solid rgba(107, 63, 160, 0.5);
  color: #c9a8ff;
  font-size: 28rpx;
}

/* ============ 列表卡片 ============ */
.resume-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.resume-card {
  background: #0d0d1a;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.resume-card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.resume-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #f1f1ff;
  flex: 1;
}

.resume-card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8aa0;
}

.resume-card-body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c9c9de;
  line-height: 1.55;
}

.resume-remove {
  padding: 8rpx 24rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.4);
  color: #f87171;
  font-size: 24rpx;
  flex-shrink: 0;
}

.resume-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.resume-tag {
  font-size: 22rpx;
  color: #c8ff50;
  background: rgba(200, 255, 80, 0.08);
  border: 1rpx solid rgba(200, 255, 80, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

/* ============ 悬浮添加按钮（FAB） ============ */
.resume-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  background: #c8ff50;
  color: #0a0a1a;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(200, 255, 80, 0.25);
  z-index: 10;
}

/* ============ 半屏表单 ============ */
.resume-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.resume-sheet {
  width: 100%;
  background: #0d0d1a;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1rpx solid rgba(200, 255, 80, 0.2);
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.resume-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: center;
}

.resume-modes {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.resume-mode {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #b8b8c8;
  font-size: 26rpx;
}

.resume-mode.on {
  background: rgba(200, 255, 80, 0.12);
  border-color: rgba(200, 255, 80, 0.5);
  color: #c8ff50;
  font-weight: 600;
}

.resume-input {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  color: #f1f1ff;
  font-size: 28rpx;
}

.resume-input-ph {
  color: #6b6b80;
}

.resume-form-error {
  font-size: 24rpx;
  color: #f87171;
  text-align: center;
}

.resume-sheet-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 8rpx;
}

.resume-btn-ghost,
.resume-btn-primary {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.resume-btn-ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  color: #b8b8c8;
}

.resume-btn-primary {
  background: #c8ff50;
  color: #0a0a1a;
}

.resume-btn-primary.disabled {
  opacity: 0.5;
}

.resume-bottom-safe {
  height: 160rpx;
}
