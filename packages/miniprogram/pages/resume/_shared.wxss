/* 简历页族共用：PlanetX 暗黑壳，空态/降级不依赖 vant */
page {
  background: #0a0e1a;
  color: #fff;
}

.resume-page {
  height: 100vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.resume-header {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.resume-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.resume-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.resume-loading,
.resume-error,
.resume-degrade,
.resume-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  text-align: center;
}

.resume-muted {
  font-size: 28rpx;
  color: #64748b;
}

.resume-error-text {
  font-size: 28rpx;
  color: #f87171;
  margin-bottom: 24rpx;
}

.resume-retry {
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  background: rgba(200, 255, 80, 0.12);
  border: 1rpx solid rgba(200, 255, 80, 0.35);
  color: #c8ff50;
  font-size: 28rpx;
}

.resume-degrade-title {
  font-size: 30rpx;
  color: #94a3b8;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.resume-degrade-hint {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  max-width: 520rpx;
}

.resume-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.resume-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.resume-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.resume-card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.resume-card-body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.55;
}

.resume-bottom-safe {
  height: 60rpx;
}
