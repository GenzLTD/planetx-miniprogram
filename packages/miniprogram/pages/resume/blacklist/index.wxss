@import "../_shared.wxss";

/* ── 列表搜索条（纯客户端过滤）── */
.resume-search {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 32rpx 8rpx;
}

.resume-search-input {
  flex: 1;
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  color: #f1f1ff;
  font-size: 28rpx;
}

.resume-search-clear {
  font-size: 26rpx;
  color: #c8ff50;
  padding: 10rpx 8rpx;
}
