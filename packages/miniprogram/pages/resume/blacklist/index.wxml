<scroll-view class="resume-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="resume-header">
    <text class="resume-title">屏蔽企业</text>
    <text class="resume-subtitle" wx:if="{{total > 0 && !notReady}}">已屏蔽 {{total}} 家 · 推荐与投递将自动过滤</text>
  </view>

  <!-- 加载态：skeleton 骨架条 -->
  <view class="resume-skeleton" wx:if="{{loading}}">
    <view class="resume-skel-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="resume-skel-line w60"></view>
      <view class="resume-skel-line w40"></view>
    </view>
  </view>

  <view class="resume-error" wx:if="{{error && !loading}}">
    <text class="resume-error-text">{{error}}</text>
    <view class="resume-retry" bindtap="loadBlacklist">
      <text>重试</text>
    </view>
  </view>

  <!-- 降级空态：not_implemented 专属，不是加载失败 -->
  <view class="resume-degrade" wx:if="{{notReady && !loading}}">
    <text class="resume-degrade-badge">✦ 阶段3 预留</text>
    <text class="resume-degrade-title">屏蔽列表即将开放</text>
    <text class="resume-degrade-hint">服务端尚未实现 GET /v1/resume/blacklist（阶段3 落地）。当前为空态降级，不是加载失败。</text>
  </view>

  <view class="resume-list" wx:if="{{!loading && !error && !notReady}}">
    <view class="resume-card" wx:for="{{items}}" wx:key="id">
      <view class="resume-card-row">
        <text class="resume-card-title">{{item.company_name}}</text>
        <view class="resume-remove" data-id="{{item.id}}" bindtap="removeItem">移除</view>
      </view>
      <text class="resume-card-meta" wx:if="{{item.match}}">匹配方式 · {{item.match}}</text>
      <text class="resume-card-meta" wx:if="{{item.credit_code}}">信用代码 · {{item.credit_code}}</text>
      <text class="resume-card-meta" wx:if="{{item.enterprise_id}}">企业 ID · {{item.enterprise_id}}</text>
      <text class="resume-card-body" wx:if="{{item.note}}">{{item.note}}</text>
    </view>
    <view class="resume-empty" wx:if="{{items.length === 0}}">
      <text class="resume-degrade-title">暂无屏蔽企业</text>
      <text class="resume-degrade-hint">列表已接通。添加屏蔽后，推荐与投递将按此过滤。</text>
    </view>
  </view>

  <view class="resume-bottom-safe"></view>
</scroll-view>

<!-- 悬浮添加入口：契约 POST /v1/resume/blacklist 的页面归宿 -->
<view class="resume-fab" bindtap="openAdd" wx:if="{{!loading}}">＋ 添加屏蔽</view>

<!-- 半屏添加表单 -->
<view class="resume-sheet-mask" wx:if="{{showAdd}}" bindtap="closeAdd">
  <view class="resume-sheet" catchtap="noop">
    <text class="resume-sheet-title">添加屏蔽企业</text>

    <!-- match 三选一 -->
    <view class="resume-modes">
      <view
        wx:for="{{matchOptions}}"
        wx:key="value"
        class="resume-mode {{matchIndex === index ? 'on' : ''}}"
        data-index="{{index}}"
        bindtap="onMatchTap"
      >{{item.label}}</view>
    </view>

    <input
      class="resume-input"
      placeholder="{{matchOptions[matchIndex].placeholder}}"
      placeholder-class="resume-input-ph"
      value="{{form[matchOptions[matchIndex].field]}}"
      data-field="{{matchOptions[matchIndex].field}}"
      bindinput="onFormInput"
    />

    <input
      class="resume-input"
      placeholder="备注（可选）"
      placeholder-class="resume-input-ph"
      value="{{form.note}}"
      data-field="note"
      bindinput="onFormInput"
    />

    <view class="resume-form-error" wx:if="{{formError}}">{{formError}}</view>

    <view class="resume-sheet-actions">
      <view class="resume-btn-ghost" bindtap="closeAdd">取消</view>
      <view class="resume-btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submitAdd">
        {{submitting ? '提交中…' : '确认屏蔽'}}
      </view>
    </view>
  </view>
</view>
