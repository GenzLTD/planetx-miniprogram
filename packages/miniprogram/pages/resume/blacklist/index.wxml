<scroll-view class="resume-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="resume-header">
    <text class="resume-title">屏蔽企业</text>
    <text class="resume-subtitle" wx:if="{{total > 0 && keyword}}">匹配 {{filteredItems.length}} / 共 {{total}} 家</text>
    <text class="resume-subtitle" wx:elif="{{total > 0 && !notReady}}">已屏蔽 {{total}} 家 · 推荐与投递将自动过滤</text>
  </view>

  <!-- 加载态：skeleton 骨架条 -->
  <view class="resume-skeleton" wx:if="{{loading}}">
    <view class="resume-skel-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="resume-skel-line w60"></view>
      <view class="resume-skel-line w40"></view>
    </view>
  </view>

  <view class="resume-error" wx:if="{{error && !loading}}">
    <text class="resume-error-text">{{error}}</text>
    <view class="resume-retry" bindtap="loadBlacklist">
      <text>重试</text>
    </view>
  </view>

  <!-- 降级空态：not_implemented 专属，不是加载失败 -->
  <view class="resume-degrade" wx:if="{{notReady && !loading}}">
    <text class="resume-degrade-badge">✦ 接口未开放</text>
    <text class="resume-degrade-title">屏蔽列表暂不可用</text>
    <text class="resume-degrade-hint">当前后端版本尚未实现 GET /v1/resume/blacklist（501 not_implemented）。不是加载失败。</text>
  </view>

  <!-- 搜索条：纯客户端过滤，命中展示名/键值/备注 -->
  <view class="resume-search" wx:if="{{!loading && !error && !notReady && items.length > 0}}">
    <input
      class="resume-search-input"
      placeholder="搜索企业名 / 信用代码 / 备注"
      placeholder-class="resume-input-ph"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <text class="resume-search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清空</text>
  </view>

  <view class="resume-list" wx:if="{{!loading && !error && !notReady}}">
    <view class="resume-card" wx:for="{{filteredItems}}" wx:key="id">
      <view class="resume-card-row">
        <text class="resume-card-title">{{item.displayName}}</text>
        <view class="resume-remove" data-id="{{item.id}}" bindtap="removeItem">移除</view>
      </view>
      <text class="resume-card-meta">匹配方式 · {{item.matchLabel}}</text>
      <text class="resume-card-meta" wx:if="{{item.keyHint}}">{{item.keyHint}}</text>
      <text class="resume-card-body" wx:if="{{item.note}}">{{item.note}}</text>
    </view>
    <view class="resume-empty" wx:if="{{items.length === 0}}">
      <text class="resume-degrade-title">暂无屏蔽企业</text>
      <text class="resume-degrade-hint">列表已接通。添加屏蔽后，推荐与投递将按此过滤。</text>
    </view>
    <view class="resume-empty" wx:if="{{items.length > 0 && filteredItems.length === 0}}">
      <text class="resume-degrade-title">没有匹配「{{keyword}}」的屏蔽项</text>
      <text class="resume-degrade-hint">换个关键字试试，或清空搜索查看全部。</text>
    </view>
  </view>

  <view class="resume-bottom-safe"></view>
</scroll-view>

<!-- 悬浮添加入口：契约 POST /v1/resume/blacklist 的页面归宿 -->
<view class="resume-fab" bindtap="openAdd" wx:if="{{!loading}}">＋ 添加屏蔽</view>

<!-- 半屏添加表单 -->
<view class="resume-sheet-mask" wx:if="{{showAdd}}" bindtap="closeAdd">
  <view class="resume-sheet" catchtap="noop">
    <text class="resume-sheet-title">添加屏蔽企业</text>

    <!-- match 三选一 -->
    <view class="resume-modes">
      <view
        wx:for="{{matchOptions}}"
        wx:key="value"
        class="resume-mode {{matchIndex === index ? 'on' : ''}}"
        data-index="{{index}}"
        bindtap="onMatchTap"
      >{{item.label}}</view>
    </view>

    <input
      class="resume-input"
      placeholder="{{matchOptions[matchIndex].placeholder}}"
      placeholder-class="resume-input-ph"
      value="{{form[matchOptions[matchIndex].field]}}"
      data-field="{{matchOptions[matchIndex].field}}"
      bindinput="onFormInput"
    />

    <!-- 非 exact_name 形态：选填展示名。服务端三种形态都落 company_name；
         enterprise_id 留空时服务端还会从 enterprises 表 best-effort 补名 -->
    <input
      wx:if="{{matchOptions[matchIndex].value !== 'exact_name'}}"
      class="resume-input"
      placeholder="企业名称（选填，用于列表展示与搜索）"
      placeholder-class="resume-input-ph"
      value="{{form.display_name}}"
      data-field="display_name"
      bindinput="onFormInput"
    />

    <input
      class="resume-input"
      placeholder="备注（可选）"
      placeholder-class="resume-input-ph"
      value="{{form.note}}"
      data-field="note"
      bindinput="onFormInput"
    />

    <view class="resume-form-error" wx:if="{{formError}}">{{formError}}</view>

    <view class="resume-sheet-actions">
      <view class="resume-btn-ghost" bindtap="closeAdd">取消</view>
      <view class="resume-btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submitAdd">
        {{submitting ? '提交中…' : '确认屏蔽'}}
      </view>
    </view>
  </view>
</view>
