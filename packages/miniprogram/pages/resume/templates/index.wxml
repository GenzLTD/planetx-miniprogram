<scroll-view class="resume-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="resume-header">
    <text class="resume-title">简历模板</text>
    <text class="resume-subtitle" wx:if="{{total > 0 && !notReady}}">共 {{total}} 套模板</text>
  </view>

  <!-- 加载态：skeleton 骨架条 -->
  <view class="resume-skeleton" wx:if="{{loading}}">
    <view class="resume-skel-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="resume-skel-line w60"></view>
      <view class="resume-skel-line w40"></view>
      <view class="resume-skel-line w80"></view>
    </view>
  </view>

  <view class="resume-error" wx:if="{{error && !loading}}">
    <text class="resume-error-text">{{error}}</text>
    <view class="resume-retry" bindtap="loadTemplates">
      <text>重试</text>
    </view>
  </view>

  <!-- 降级空态 + 导流：别把用户晾在死胡同 -->
  <view class="resume-degrade" wx:if="{{notReady && !loading}}">
    <text class="resume-degrade-badge">✦ 阶段3 预留</text>
    <text class="resume-degrade-title">模板目录即将开放</text>
    <text class="resume-degrade-hint">服务端尚未实现 GET /v1/resume/templates（阶段3 落地）。当前为空态降级，不是加载失败。</text>
    <view class="resume-cta" bindtap="goParse">
      <text>先去解析一份简历 →</text>
    </view>
  </view>

  <view class="resume-list" wx:if="{{!loading && !error && !notReady}}">
    <view class="resume-card" wx:for="{{templates}}" wx:key="id">
      <text class="resume-card-title">{{item.name}}</text>
      <text class="resume-card-meta" wx:if="{{item.locale}}">{{item.locale}}</text>
      <view class="resume-tags" wx:if="{{item.tags && item.tags.length > 0}}">
        <text class="resume-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <text class="resume-card-body" wx:if="{{item.summary}}">{{item.summary}}</text>
    </view>
    <view class="resume-empty" wx:if="{{templates.length === 0}}">
      <text class="resume-degrade-title">暂无模板</text>
      <text class="resume-degrade-hint">目录已接通，但当前没有可展示的模板。</text>
    </view>
  </view>

  <view class="resume-bottom-safe"></view>
</scroll-view>
