.page { position: relative; z-index: 1; padding: 32rpx 32rpx 80rpx; }
.h1 { font-size: 40rpx; font-weight: 800; color: #C8FF50; }
.lead, .muted, .growth { margin-top: 12rpx; font-size: 24rpx; color: #B8B8C8; line-height: 1.6; }
.actions { display: flex; gap: 16rpx; margin: 28rpx 0; }
.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid rgba(200, 255, 80, 0.35);
  color: #C8FF50;
  font-size: 26rpx;
}
.btn.solid { margin-top: 20rpx; background: #C8FF50; color: #0a0a1a; font-weight: 700; }
.item {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(13, 13, 26, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.when { font-size: 22rpx; color: #8888aa; }
.title { margin-top: 8rpx; font-size: 30rpx; color: #ffffff; font-weight: 700; }
.summary { margin-top: 8rpx; font-size: 24rpx; color: #B8B8C8; line-height: 1.5; }
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  padding: 32rpx;
  background: #12121f;
  border-radius: 24rpx 24rpx 0 0;
}
.sheet-title { font-size: 32rpx; color: #ffffff; font-weight: 700; margin-bottom: 16rpx; }
.field {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
}
.field.line { min-height: 0; height: 80rpx; margin-bottom: 16rpx; }
