<star-bg />
<view class="page">
  <view class="logo">Planet<text class="logo-x">X</text></view>
  <view class="slogan">选择你的星际身份</view>
  <view class="lead">这里不是投简历的地方。先看清你在做什么、和谁共事过；画像会随着记录变准，机会是后面的事。</view>
  <view class="ask">你正在寻找什么？</view>

  <view
    wx:for="{{cards}}"
    wx:key="type"
    class="card"
    data-type="{{item.type}}"
    bindtap="onSelect"
  >
    <view class="emoji">{{item.emoji}}</view>
    <view class="title">{{item.title}}</view>
    <view class="desc">{{item.desc}}</view>
    <view class="tag">{{item.tag}}</view>
  </view>
</view>
