.page {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx 80rpx;
}
.logo {
  text-align: center;
  font-size: 48rpx;
  font-weight: 900;
  color: #C8FF50;
  letter-spacing: 4rpx;
}
.logo-x { color: #7C5CFF; }
.slogan, .ask {
  text-align: center;
  color: #ffffff;
  font-weight: 700;
}
.slogan { margin-top: 12rpx; font-size: 24rpx; letter-spacing: 6rpx; color: #B8B8C8; }
.lead {
  margin: 24rpx auto 0;
  max-width: 640rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.65;
  color: #8888aa;
}
.ask { margin: 36rpx 0 24rpx; font-size: 36rpx; }
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(13, 13, 26, 0.92);
  border: 1rpx solid rgba(200, 255, 80, 0.22);
}
.emoji { font-size: 56rpx; }
.title { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; color: #ffffff; }
.desc { margin-top: 8rpx; font-size: 24rpx; color: #B8B8C8; line-height: 1.5; }
.tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #C8FF50;
  background: rgba(200, 255, 80, 0.12);
}
